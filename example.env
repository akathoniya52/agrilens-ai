# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# Google OAuth (sign-in)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google Gemini API (AI answers, diagnosis, transcription)
GOOGLE_API_KEY=your_gemini_api_key

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/agrilens

# Vercel Blob (image uploads; unset = base64 data-URL fallback in dev)
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token
# Exact hostname of your Blob store, e.g. abc123.public.blob.vercel-storage.com
# (unset = any *.public.blob.vercel-storage.com host; image URLs must still be under /uploads/<userId>/)
BLOB_STORE_HOST=

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com

# Cron jobs (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=your_cron_secret

# --- Phase 4 (all optional; each feature shows a "not configured" state when unset) ---

# Satellite NDVI (Copernicus Data Space or Sentinel Hub OAuth client)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
# Default: https://sh.dataspace.copernicus.eu (commercial: https://services.sentinel-hub.com)
SENTINEL_HUB_BASE_URL=
# Default: https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
SENTINEL_HUB_TOKEN_URL=

# On-device TF.js model (unset = on-device hint and live scan detection are hidden)
NEXT_PUBLIC_TFJS_MODEL_URL=
# Default: labels.json next to the model
NEXT_PUBLIC_TFJS_LABELS_URL=
# layers | graph (default: try layers, then graph)
NEXT_PUBLIC_TFJS_MODEL_FORMAT=
# Square input size in px (default 224)
NEXT_PUBLIC_TFJS_INPUT_SIZE=
# 0,1 (default) | -1,1 | none
NEXT_PUBLIC_TFJS_NORMALIZE=

# Mandi prices (data.gov.in Agmarknet API key)
DATA_GOV_IN_API_KEY=

# RAG knowledge base (uses GOOGLE_API_KEY for embeddings)
# Default: gemini-embedding-001 (768 dims)
GEMINI_EMBEDDING_MODEL=
# Atlas Vector Search index on knowledges.embedding (unset = in-memory cosine fallback)
ATLAS_VECTOR_INDEX=
# Max chunks loaded for the in-memory fallback (default 2000)
RAG_FALLBACK_LIMIT=

# Expert cases: comma/space-separated agronomist emails
EXPERT_EMAILS=

# WhatsApp Cloud API (all but WHATSAPP_GRAPH_VERSION required, else /api/whatsapp returns 503)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Default: v21.0
WHATSAPP_GRAPH_VERSION=

# IoT sensors need no env vars: each field gets its own device token (POST /api/fields/[fieldId]/iot-token)
